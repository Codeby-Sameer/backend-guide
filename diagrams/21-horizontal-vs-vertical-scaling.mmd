        H_LB --> HN["Stateless Instance N..."]
        H_State["Shared State: Redis Cluster and DB Shards/Replicas"]
        H1 --> H_State
        H2 --> H_State
        H3 --> H_State
        HN --> H_State
        H_Pros["Pros: Near-infinite elasticity, high availability, fault tolerance"]
        H_Cons["Cons: Network latency, distributed state, consistency challenges"]
    end
